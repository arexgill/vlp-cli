{
  "name": "vlp-cli-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "vlp-cli-workspace",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@arexgill/vlp-cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@arexgill/vlp-core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@arexgill/vlp-ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/cli": {
      "name": "@arexgill/vlp-cli",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "vlp": "bin/vlp.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/core": {
      "name": "@arexgill/vlp-core",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/ui": {
      "name": "@arexgill/vlp-ui",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    }
  }
}
